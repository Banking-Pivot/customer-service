        {
          "name": "20 Pasar a VIP con el ETag vigente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Perfil VIP, nombre nuevo y ETag \"1\"', () => {",
                  "  pm.expect(body.profile).to.eql('VIP');",
                  "  pm.expect(body.name).to.eql('Ana Perez Gomez');",
                  "  pm.expect(pm.response.headers.get('ETag')).to.eql('\"1\"');",
                  "});",
                  "pm.collectionVariables.set('staleEtag', pm.collectionVariables.get('etag'));",
                  "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "{{etag}}"
              }
            ],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Perez Gomez\",\n  \"profile\": \"VIP\"\n}"
            }
          }
        },
        {
          "name": "21 Repetir los mismos valores (200, mismo ETag)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Sin cambios no sube la versión', () => {",
                  "  pm.expect(pm.response.headers.get('ETag')).to.eql(pm.collectionVariables.get('etag'));",
                  "});"
                ]
              }
            }
          ],
