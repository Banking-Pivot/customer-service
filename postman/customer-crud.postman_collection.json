    {
      "name": "4. Actualización con If-Match",
      "description": "PUT reemplaza nombre y perfil y exige el ETag vigente en If-Match: sin cabecera 428, con un formato distinto de \"n\" 400, con una versión vieja 412. El tipo y el documento no se pueden cambiar, y el perfil nuevo tiene que ser válido para el tipo.",
      "item": [
        {
          "name": "15 Consultar el cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('ETag \"0\" y datos de la creación', () => {",
                  "  pm.expect(pm.response.headers.get('ETag')).to.eql('\"0\"');",
                  "  pm.expect(body.profile).to.eql('STANDARD');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "16 Sin If-Match (428)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('428 IF_MATCH_REQUIRED', () => {",
                  "  pm.response.to.have.status(428);",
                  "  pm.expect(pm.response.json().code).to.eql('IF_MATCH_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Perez Gomez\",\n  \"profile\": \"VIP\"\n}"
            }
          }
        },
        {
          "name": "17 If-Match débil W/\"0\" (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 INVALID_IF_MATCH', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('INVALID_IF_MATCH');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "W/\"0\""
              }
            ],
            "url": "{{baseUrl}}/customers/{{customerId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Perez Gomez\",\n  \"profile\": \"VIP\"\n}"
            }
          }
        },
